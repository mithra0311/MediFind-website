# =========================================================================
# MediFind Environment Variables Example
# Duplicate this file as .env or configure in application.properties
# =========================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medifind_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Server Port
PORT=8080

# Security / Token Secret
JWT_SECRET=replace_with_a_secure_random_secret

# Geolocation Demonstration Defaults
DEFAULT_LATITUDE=12.9516
DEFAULT_LONGITUDE=80.1462
DEFAULT_LOCALITY="Chromepet, Chennai"
